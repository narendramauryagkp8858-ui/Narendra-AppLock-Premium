
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#080C1C">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔐"
        android:textSize="60sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHANGE SECURITY PIN"
        android:textColor="#00BEFF"
        android:textSize="23sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="28dp"/>

    <EditText
        android:id="@+id/oldPin"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Enter Old MPIN"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:hintTextColor="#8B9AB5"
        android:backgroundTint="#00BEFF"/>

    <EditText
        android:id="@+id/newPin"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="18dp"
        android:hint="Enter New MPIN"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:hintTextColor="#8B9AB5"
        android:backgroundTint="#00BEFF"/>

    <EditText
        android:id="@+id/confirmPin"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="18dp"
        android:hint="Confirm New MPIN"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:hintTextColor="#8B9AB5"
        android:backgroundTint="#00BEFF"/>

    <TextView
        android:id="@+id/changePinMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FF5252"
        android:layout_marginTop="15dp"/>

    <Button
        android:id="@+id/saveNewPin"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="22dp"
        android:text="UPDATE MPIN"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#087DDB"/>

</LinearLayout>
