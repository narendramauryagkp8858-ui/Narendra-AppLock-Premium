
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#080C1C">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHANGE MPIN"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#00BEFF"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/oldPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Current MPIN"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA" />

    <EditText
        android:id="@+id/newPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="New 4-digit MPIN"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA" />

    <EditText
        android:id="@+id/confirmPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Confirm New MPIN"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA" />

    <TextView
        android:id="@+id/changePinMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF7777"
        android:padding="8dp" />

    <Button
        android:id="@+id/saveNewPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SAVE NEW MPIN" />

</LinearLayout>
