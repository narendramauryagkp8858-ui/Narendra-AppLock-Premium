
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#080C1C">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NARENDRA"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="APPLOCK PREMIUM 3D"
        android:textSize="17sp"
        android:textColor="#00BEFF"
        android:gravity="center"
        android:padding="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ENTER YOUR 4-DIGIT MPIN"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="16dp" />

    <EditText
        android:id="@+id/pinInput"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Enter MPIN"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA" />

    <TextView
        android:id="@+id/pinError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF5555"
        android:gravity="center"
        android:padding="8dp" />

    <Button
        android:id="@+id/verifyPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UNLOCK APP" />

</LinearLayout>
